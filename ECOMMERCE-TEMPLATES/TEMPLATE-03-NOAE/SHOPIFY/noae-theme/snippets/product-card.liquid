{%- comment -%}
  snippets/product-card.liquid
  Ported 1:1 from the demo's js/products.js -> renderProductCard(): hover-swap
  image, badge, wishlist heart, category eyebrow, name, star rating, price /
  compare / discount, and a Quick Add + Quick View pair on hover.
  Accepts: product (required), quick_actions (optional bool, default true)

  RATING METAFIELDS (documented convention — no reviews app assumed):
    product.metafields.custom.rating        (number, e.g. 4.8)
    product.metafields.custom.rating_count   (number, e.g. 214)
  If a reviews app (Judge.me / Loox / etc.) is installed, point these two
  lines at that app's namespace instead. When absent, the star row is not
  rendered.

  BADGE LOGIC (computed, never hardcoded):
    - "Bestseller" when the product has tag "bestseller"  -> noae-badge--rose
    - "Limited"    when the product has tag "limited"     -> noae-badge--gold
    - "New"        when published within the last 21 days -> noae-badge--sage
    - Discount chip (-XX%) always computed independently from
      compare_at_price vs price, shown top-right regardless of the badge.
{%- endcomment -%}
{%- liquid
  assign card_variant = product.selected_or_first_available_variant
  assign on_sale = false
  if card_variant.compare_at_price > card_variant.price
    assign on_sale = true
    assign discount_pct = card_variant.compare_at_price | minus: card_variant.price | times: 100.0 | divided_by: card_variant.compare_at_price | round
  endif

  assign is_new = false
  assign created_seconds = product.created_at | date: '%s'
  assign now_seconds = 'now' | date: '%s'
  assign age_seconds = now_seconds | minus: created_seconds
  assign age_days = age_seconds | divided_by: 86400
  if age_days <= 21
    assign is_new = true
  endif

  assign badge_label = ''
  assign badge_class = ''
  if product.tags contains 'bestseller'
    assign badge_label = 'Bestseller'
    assign badge_class = 'noae-badge--rose'
  elsif product.tags contains 'limited'
    assign badge_label = 'Limited'
    assign badge_class = 'noae-badge--gold'
  elsif is_new
    assign badge_label = 'New'
    assign badge_class = 'noae-badge--sage'
  endif

  assign show_quick_actions = quick_actions | default: true
  assign secondary_image = product.media[1] | default: product.featured_media

  assign rating = product.metafields.custom.rating.value
  assign rating_count = product.metafields.custom.rating_count.value
-%}
<article class="noae-product-card" data-product-id="{{ product.id }}" data-product-handle="{{ product.handle }}" data-category="{{ product.type }}">
  <div class="noae-product-card__media">
    <a href="{{ product.url }}" class="noae-product-card__link" aria-label="View {{ product.title | escape }}">
      {%- if product.featured_media -%}
        <img class="noae-product-card__img noae-product-card__img--main" src="{{ product.featured_media | image_url: width: 400, height: 480, crop: 'center' }}" alt="{{ product.featured_media.alt | default: product.title | escape }}" width="400" height="480" loading="lazy">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'noae-product-card__img noae-product-card__img--main' }}
      {%- endif -%}
      {%- if secondary_image -%}
        <img class="noae-product-card__img noae-product-card__img--hover" src="{{ secondary_image | image_url: width: 400, height: 480, crop: 'center' }}" alt="{{ product.title | escape }} texture detail" width="400" height="480" loading="lazy">
      {%- endif -%}
    </a>
    {%- if badge_label != '' -%}
      <span class="noae-badge {{ badge_class }}">{{ badge_label }}</span>
    {%- endif -%}
    {%- if on_sale -%}
      <span class="noae-badge noae-badge--discount">-{{ discount_pct }}%</span>
    {%- endif -%}
    {%- if settings.enable_wishlist -%}
      <button type="button" class="noae-icon-btn noae-wishlist-toggle" data-wishlist-toggle data-handle="{{ product.handle }}" aria-label="Add {{ product.title | escape }} to wishlist" aria-pressed="false">
        {%- render 'icon', icon: 'wishlist', width: 18, height: 18 -%}
      </button>
    {%- endif -%}
    {%- if show_quick_actions -%}
      {%- if card_variant.available -%}
        <button type="button" class="noae-btn noae-btn--quickview" data-quickview data-handle="{{ product.handle }}">{{ 'sections.product.quick_view' | t }}</button>
      {%- endif -%}
    {%- endif -%}
  </div>
  <div class="noae-product-card__body">
    <p class="noae-product-card__category">{{ product.type | default: product.collections.first.title }}</p>
    <h3 class="noae-product-card__name"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {%- if rating -%}
      <div class="noae-product-card__rating" aria-label="Rated {{ rating }} out of 5">
        {%- for i in (1..5) -%}
          {%- if i <= rating -%}<span class="noae-star noae-star--full">★</span>{%- else -%}<span class="noae-star noae-star--empty">☆</span>{%- endif -%}
        {%- endfor -%}
        <span class="noae-product-card__review-count">({{ rating_count | default: 0 }})</span>
      </div>
    {%- endif -%}
    {%- render 'price', product: product, variant: card_variant -%}
    {%- if show_quick_actions -%}
      {%- if card_variant.available -%}
        <button class="noae-btn noae-btn--outline noae-btn--full noae-quick-add" type="button" data-quickadd data-variant-id="{{ card_variant.id }}">{{ 'sections.product.quick_add' | t }}</button>
      {%- else -%}
        <button class="noae-btn noae-btn--outline noae-btn--full" type="button" disabled>{{ 'sections.product.sold_out' | t }}</button>
      {%- endif -%}
    {%- endif -%}
  </div>
</article>
