{%- comment -%}
  snippets/icon.liquid
  Inline SVG icons ported 1:1 from the NOAÉ demo's header/drawer/cart/wishlist
  markup (index.html). Usage: {% render 'icon', icon: 'search', width: 18, height: 18 %}
{%- endcomment -%}
{%- liquid
  assign w = width | default: 18
  assign h = height | default: 18
-%}
{%- case icon -%}
  {%- when 'menu' -%}
    <span class="noae-hamburger-lines" aria-hidden="true"><span></span><span></span><span></span></span>
  {%- when 'search' -%}
    <svg width="{{ w }}" height="{{ h }}" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" fill="none"/><line x1="16.6" y1="16.6" x2="21" y2="21" stroke="currentColor" stroke-width="2"/></svg>
  {%- when 'account' -%}
    <svg width="{{ w }}" height="{{ h }}" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" fill="currentColor"/><path d="M4 20c0-4 3.6-6 8-6s8 2 8 6" fill="currentColor"/></svg>
  {%- when 'wishlist' -%}
    <svg width="{{ w }}" height="{{ h }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.7-10-9.3C.5 8.1 2 4.5 5.6 3.7 8 3.2 10.2 4.3 12 6.7 13.8 4.3 16 3.2 18.4 3.7 22 4.5 23.5 8.1 22 11.7 19.5 16.3 12 21 12 21z" fill="currentColor"/></svg>
  {%- when 'cart' -%}
    <svg width="{{ w }}" height="{{ h }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8h12l-1.2 11.2a2 2 0 01-2 1.8H9.2a2 2 0 01-2-1.8L6 8z" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M9 8V6a3 3 0 016 0v2" stroke="currentColor" stroke-width="1.6" fill="none"/></svg>
  {%- when 'close' -%}
    <span aria-hidden="true">&#10005;</span>
  {%- when 'instagram' -%}
    <span aria-hidden="true">IG</span>
  {%- when 'pinterest' -%}
    <span aria-hidden="true">PN</span>
  {%- when 'facebook' -%}
    <span aria-hidden="true">FB</span>
{%- endcase -%}
