{%- comment -%}
  sections/newsletter.liquid
  Standalone rose-tinted newsletter / "skin quiz" block, ported 1:1 from the
  demo's #skin-quiz section (.noae-newsletter). Uses Shopify's native
  {% form 'customer' %} tagged "newsletter" so subscribers land in
  Customers > all customers with that tag — no third-party ESP required.
{%- endcomment -%}
<section class="noae-section noae-reveal" id="skin-quiz">
  <div class="noae-container">
    <div class="noae-newsletter">
      <span class="noae-section__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.body }}</p>
      {%- form 'customer', id: 'newsletterForm', class: 'noae-newsletter__form js-newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="newsletterEmail" class="noae-visually-hidden">Email address</label>
        <input type="email" id="newsletterEmail" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required>
        <button type="submit" class="noae-btn noae-btn--dark">{{ section.settings.button_text }}</button>
        {%- if form.posted_successfully? -%}
          <script>document.addEventListener('DOMContentLoaded', function(){ if (window.NoaeToast) window.NoaeToast.show({{ 'sections.footer.newsletter_success' | t | json }}, 'success'); });</script>
        {%- endif -%}
      {%- endform -%}
      <p class="noae-newsletter__note">{{ section.settings.note }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find Your Ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Does Your Skin Need?"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Join the list for a personalised routine match, early access to launches, and 10% off your first order."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "you@email.com"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Get My Match"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note text",
      "default": "Use code NOAE10 at checkout. No spam, unsubscribe anytime."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
