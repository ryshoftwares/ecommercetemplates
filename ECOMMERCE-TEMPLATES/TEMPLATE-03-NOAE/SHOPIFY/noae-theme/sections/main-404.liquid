{%- comment -%}
  sections/main-404.liquid
  Ported 1:1 from the demo's 404.html .noae-404 markup, plus the "Shop By
  Concern" quick-links block (reused from sections/shop-by-concern.liquid
  content pattern) to keep lost visitors browsing.
{%- endcomment -%}
<div class="noae-container">
  <div class="noae-404">
    <p class="noae-404__code">404</p>
    <h1>{{ section.settings.heading }}</h1>
    <p class="noae-page-header__intro">{{ section.settings.body }}</p>
    <div class="noae-404__actions">
      <a href="{{ routes.root_url }}" class="noae-btn noae-btn--primary">{{ section.settings.home_button_text }}</a>
      <a href="{{ routes.all_products_collection_url }}" class="noae-btn noae-btn--outline">{{ section.settings.shop_button_text }}</a>
      {%- if section.settings.contact_page != blank -%}
        <a href="{{ pages[section.settings.contact_page].url }}" class="noae-btn noae-btn--outline">{{ section.settings.contact_button_text }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if section.settings.show_categories and section.blocks.size > 0 -%}
<section class="noae-section noae-section--soft noae-reveal">
  <div class="noae-container">
    <div class="noae-section__head">
      <span class="noae-section__eyebrow">{{ section.settings.categories_eyebrow }}</span>
      <h2>{{ section.settings.categories_heading }}</h2>
    </div>
    <div class="noae-concern-grid">
      {%- for block in section.blocks -%}
        {%- assign concern_collection = collections[block.settings.collection] -%}
        <a href="{{ concern_collection.url | default: '#' }}" class="noae-concern-pill" {{ block.shopify_attributes }}>
          <span class="noae-concern-pill__media">
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.name | escape }}" width="300" height="300" loading="lazy">
            {%- elsif concern_collection.image -%}
              <img src="{{ concern_collection.image | image_url: width: 600 }}" alt="{{ block.settings.name | escape }}" width="300" height="300" loading="lazy">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'noae-concern-pill__placeholder' }}
            {%- endif -%}
          </span>
          <span class="noae-concern-pill__name">{{ block.settings.name }}</span>
          <span class="noae-concern-pill__count">{{ block.settings.description }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "404 page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This Page Skipped Its Ritual"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "The page you're looking for has been moved, renamed, or never existed. Let's get you back to something worth browsing."
    },
    {
      "type": "text",
      "id": "home_button_text",
      "label": "Home button label",
      "default": "Back To Home"
    },
    {
      "type": "text",
      "id": "shop_button_text",
      "label": "Shop button label",
      "default": "Shop All Products"
    },
    {
      "type": "text",
      "id": "contact_button_text",
      "label": "Contact button label",
      "default": "Contact Support"
    },
    {
      "type": "text",
      "id": "contact_page",
      "label": "Contact page handle",
      "default": "contact"
    },
    {
      "type": "checkbox",
      "id": "show_categories",
      "label": "Show category quick links",
      "default": true
    },
    {
      "type": "text",
      "id": "categories_eyebrow",
      "label": "Categories eyebrow",
      "default": "Or Start Here"
    },
    {
      "type": "text",
      "id": "categories_heading",
      "label": "Categories heading",
      "default": "Find Your Category"
    }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Category pill",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Category name",
          "default": "Skincare"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short description",
          "default": "Serums, creams & masks for visible results"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Linked collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "concern", "settings": { "name": "Skincare", "description": "Serums, creams & masks for visible results" } },
      { "type": "concern", "settings": { "name": "Haircare", "description": "Nourishing washes and oils for stronger strands" } },
      { "type": "concern", "settings": { "name": "Wellness", "description": "Rituals for calm, sleep, and everyday balance" } },
      { "type": "concern", "settings": { "name": "Body", "description": "Whipped butters and oils for soft, cared-for skin" } }
    ]
  }
}
{% endschema %}
