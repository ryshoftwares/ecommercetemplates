{%- comment -%}
  sections/main-page.liquid
  Generic page content section, referenced by templates/page.json. Renders
  the page's real title + page.content richtext inside the demo's
  .noae-page-header + container pattern. Used for any plain content page
  (policies, etc.); About and Contact use their own richer template JSON
  (page.about.json / page.contact.json) built from sections/about-hero.liquid,
  sections/values-grid.liquid and sections/contact-form.liquid instead.
{%- endcomment -%}
<section class="noae-page-header">
  <div class="noae-container">
    {%- render 'breadcrumb' -%}
    <h1>{{ page.title }}</h1>
  </div>
</section>
<div class="noae-container" style="padding-bottom:var(--space-9);">
  <div style="max-width:760px;margin:0 auto;">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Page"
}
{% endschema %}
