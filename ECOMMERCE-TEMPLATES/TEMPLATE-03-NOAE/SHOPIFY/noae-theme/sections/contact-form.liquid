{%- comment -%}
  sections/contact-form.liquid
  Ported 1:1 from the demo's contact.html form + info-card sidebar
  (.noae-contact-layout / .noae-checkout-step / .noae-info-card). Uses
  Shopify's native {% form 'contact' %} which emails the shop owner directly
  — no third-party form service required.
{%- endcomment -%}
<section class="noae-page-header">
  <div class="noae-container">
    {%- render 'breadcrumb' -%}
    <h1>{{ section.settings.heading }}</h1>
    <p class="noae-page-header__intro">{{ section.settings.intro }}</p>
  </div>
</section>

<div class="noae-container">
  <div class="noae-contact-layout">
    <section class="noae-checkout-step" aria-labelledby="contactFormTitle">
      <p class="noae-checkout-step__title" id="contactFormTitle">{{ section.settings.form_title }}</p>
      {%- form 'contact', id: 'contactForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="noae-coupon-feedback is-success">{{ 'sections.contact.success' | t }}</p>
        {%- endif -%}
        <div class="noae-form-grid">
          <div class="noae-form-field">
            <label for="contactName">Full name</label>
            <input type="text" id="contactName" name="contact[name]" placeholder="Ananya Rao" autocomplete="name" required>
          </div>
          <div class="noae-form-field">
            <label for="contactEmail">Email address</label>
            <input type="email" id="contactEmail" name="contact[email]" value="{{ form.email }}" placeholder="you@email.com" autocomplete="email" required>
          </div>
          <div class="noae-form-field">
            <label for="contactPhone">Phone number <span style="font-weight:400;color:var(--color-plum-soft);">(optional)</span></label>
            <input type="tel" id="contactPhone" name="contact[phone]" placeholder="98765 43210" autocomplete="tel">
          </div>
          <div class="noae-form-field">
            <label for="contactSubject">Subject</label>
            <select id="contactSubject" name="contact[subject]">
              <option value="general">General Enquiry</option>
              <option value="order">Order Support</option>
              <option value="returns">Returns &amp; Exchanges</option>
              <option value="wholesale">Wholesale / Stockist</option>
              <option value="press">Press</option>
            </select>
          </div>
          <div class="noae-form-field noae-form-field--full">
            <label for="contactMessage">Message</label>
            <textarea id="contactMessage" name="contact[body]" rows="5" placeholder="Tell us how we can help..." required></textarea>
          </div>
        </div>
        <button type="submit" class="noae-btn noae-btn--dark noae-btn--full noae-mt-6">{{ section.settings.submit_button_text }}</button>
      {%- endform -%}
    </section>

    <aside>
      {%- for block in section.blocks -%}
        <div class="noae-info-card" {{ block.shopify_attributes }}>
          <span class="noae-info-card__icon" aria-hidden="true">{{ block.settings.icon }}</span>
          <div>
            <p class="noae-checkout-step__title" style="margin-bottom:4px;font-size:1rem;">{{ block.settings.title }}</p>
            <div>{{ block.settings.body }}</div>
          </div>
        </div>
      {%- endfor -%}
    </aside>
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get In Touch"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Questions about an order, an ingredient, or a ritual that's right for you? Our team typically replies within 1-2 business days."
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Form card title",
      "default": "Send Us A Message"
    },
    {
      "type": "text",
      "id": "submit_button_text",
      "label": "Submit button text",
      "default": "Send Message"
    }
  ],
  "blocks": [
    {
      "type": "info_card",
      "name": "Info card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji icon",
          "default": "📍"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Studio Address"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>NOAÉ Formulation Studio, 14th Floor, Otters Business Park, Lower Parel, Mumbai 400013, Maharashtra, India</p>"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "info_card", "settings": { "icon": "📍", "title": "Studio Address", "body": "<p>NOAÉ Formulation Studio, 14th Floor, Otters Business Park, Lower Parel, Mumbai 400013, Maharashtra, India</p>" } },
      { "type": "info_card", "settings": { "icon": "📞", "title": "Phone", "body": "<p>+91 98765 43210<br>Mon–Sat, 10am–7pm IST</p>" } },
      { "type": "info_card", "settings": { "icon": "✉️", "title": "Email", "body": "<p>support@noae-demo.com<br>For order &amp; ritual support</p>" } }
    ]
  },
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
