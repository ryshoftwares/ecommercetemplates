{%- comment -%}
  sections/ingredient-spotlight.liquid
  Ported 1:1 from the demo's "FORMULATED WITH INTENTION" ethos section
  (.noae-ethos): text + block-based icon list + botanical illustration.
{%- endcomment -%}
<section class="noae-section noae-reveal">
  <div class="noae-container noae-ethos">
    <div>
      <span class="noae-section__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.body }}</p>
      {%- if section.blocks.size > 0 -%}
        <div class="noae-ethos__list">
          {%- for block in section.blocks -%}
            <div class="noae-ethos__item" {{ block.shopify_attributes }}>
              <span class="noae-ethos__icon">{{ block.settings.icon }}</span>
              <div>
                <p class="noae-ethos__item-title">{{ block.settings.title }}</p>
                <p class="noae-ethos__item-desc">{{ block.settings.description }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="noae-ethos__media">
      {%- if section.settings.image -%}
        <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" width="700" height="700" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'noae-ethos__placeholder' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredient spotlight",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Ethos"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Formulated With Intention"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Every NOAÉ formula starts with a short, honest ingredient list — actives that are proven to work, paired with skin-loving botanicals that keep the experience gentle."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Botanical image"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ethos item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji icon",
          "default": "🌿"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Clean Actives"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "No unnecessary fillers — every ingredient earns its place."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "icon": "🌿", "title": "Clean Actives", "description": "No unnecessary fillers — every ingredient earns its place." } },
      { "type": "item", "settings": { "icon": "🧪", "title": "Dermatologist-Reviewed", "description": "Formulas reviewed for safety across skin types." } },
      { "type": "item", "settings": { "icon": "🐰", "title": "Cruelty-Free", "description": "Never tested on animals, at any stage." } },
      { "type": "item", "settings": { "icon": "♻️", "title": "Recyclable Packaging", "description": "Glass and recyclable plastic wherever possible." } }
    ]
  },
  "presets": [
    {
      "name": "Ingredient spotlight"
    }
  ]
}
{% endschema %}
