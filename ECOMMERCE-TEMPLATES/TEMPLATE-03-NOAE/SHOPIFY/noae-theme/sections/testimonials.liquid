{%- comment -%}
  sections/testimonials.liquid
  Ported 1:1 from the demo's "LOVED BY OUR COMMUNITY" reviews grid
  (.noae-reviews-grid / .noae-review-card), block-based so merchants can
  add/reorder quotes freely.
{%- endcomment -%}
<section class="noae-section noae-section--soft noae-reveal">
  <div class="noae-container">
    <div class="noae-section__head">
      <span class="noae-section__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="noae-reviews-grid">
        {%- for block in section.blocks -%}
          <article class="noae-review-card" {{ block.shopify_attributes }}>
            <div class="noae-review-card__stars">
              {%- for i in (1..5) -%}{% if i <= block.settings.rating %}★{% else %}☆{% endif %}{%- endfor -%}
            </div>
            <p class="noae-review-card__quote">"{{ block.settings.quote }}"</p>
            <p class="noae-review-card__author">{{ block.settings.author }}</p>
            <p class="noae-review-card__meta">{{ block.settings.author_meta }}</p>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "In Their Words"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved By Our Community"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "My skin has never held onto moisture like this. The serum-to-cream combo is now non-negotiable."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Ananya R."
        },
        {
          "type": "text",
          "id": "author_meta",
          "label": "Author meta line",
          "default": "Verified buyer"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "testimonial", "settings": { "rating": 5, "quote": "My skin has never held onto moisture like this. The serum-to-cream combo is now non-negotiable.", "author": "Ananya R.", "author_meta": "Verified buyer" } },
      { "type": "testimonial", "settings": { "rating": 5, "quote": "The hair oil smells incredible and actually tames my frizz in humidity — first product that's done both.", "author": "Priya S.", "author_meta": "Verified buyer" } },
      { "type": "testimonial", "settings": { "rating": 5, "quote": "The sleep mist genuinely changed my bedtime routine. Subtle scent, real difference in how fast I settle down.", "author": "Meera K.", "author_meta": "Verified buyer" } }
    ]
  },
  "presets": [
    {
      "name": "Testimonials"
    }
  ]
}
{% endschema %}
