{%- comment -%}
  snippets/menu-list.liquid
  Recursively renders a Shopify linklist as nested <ul>/<li> for dropdown
  support in the primary nav. Usage: {% render 'menu-list', links: menu.links %}
{%- endcomment -%}
<ul>
  {%- for link in links -%}
    <li class="{% if link.links.size > 0 %}has-dropdown{% endif %}">
      <a href="{{ link.url }}" {% if link.active %}class="is-active"{% endif %}>{{ link.title }}</a>
      {%- if link.links.size > 0 -%}
        <div class="nav-dropdown">
          {%- render 'menu-list', links: link.links -%}
        </div>
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>
