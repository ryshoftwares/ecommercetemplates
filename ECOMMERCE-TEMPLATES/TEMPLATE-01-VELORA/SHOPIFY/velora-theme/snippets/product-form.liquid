{%- comment -%}
  snippets/product-form.liquid
  Native Shopify {% form 'product' %} — real variant picker (colour swatches +
  size pills, matching the demo's .swatch-color / .swatch-size), qty stepper,
  Add to Cart (AJAX via assets/product.js + assets/cart.js), Buy Now (native
  dynamic checkout button), and the wishlist heart toggle.
  Expects: product (required)
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
-%}
<product-form data-product-form>
{%- form 'product', product, id: 'product-form', class: 'pdp-product-form', data-product-form-el: '' -%}
  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

  {%- for option in product.options_with_values -%}
    {%- assign option_name_down = option.name | downcase -%}
    <div class="variant-group" data-option-index="{{ forloop.index0 }}">
      <div class="variant-label">
        {{ option.name }}
        <span class="selected-value" data-option-selected-value>{{ option.selected_value }}</span>
        {%- if option_name_down == 'size' -%}
          <a href="#size-guide" class="btn-text" style="font-size:11px" data-tab-link="size-guide">{{ 'sections.product.size_guide' | t }}</a>
        {%- endif -%}
      </div>
      {%- if option_name_down == 'color' or option_name_down == 'colour' -%}
        <div class="swatch-row" data-option-values>
          {%- for value in option.values -%}
            {%- capture swatch_hex -%}{% render 'color-swatch', name: value %}{%- endcapture -%}
            <button type="button"
              class="swatch-color{% if value == option.selected_value %} is-selected{% endif %}"
              style="background:{{ swatch_hex | strip }};"
              data-option-value
              data-option-index="{{ forloop.parentloop.index0 }}"
              data-value="{{ value | escape }}"
              aria-label="{{ value | escape }}"></button>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="swatch-row" data-option-values>
          {%- for value in option.values -%}
            <button type="button"
              class="swatch-size{% if value == option.selected_value %} is-selected{% endif %}"
              data-option-value
              data-option-index="{{ forloop.parentloop.index0 }}"
              data-value="{{ value | escape }}">{{ value }}</button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  {%- endfor -%}

  <div class="pdp-actions">
    <div class="qty-stepper" data-pdp-qty>
      <button type="button" data-qty-dec aria-label="Decrease quantity">-</button>
      <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="{{ 'sections.product.quantity' | t }}" data-qty-input>
      <button type="button" data-qty-inc aria-label="Increase quantity">+</button>
    </div>
    <button type="submit" name="add" class="btn btn-primary" data-pdp-add{% unless current_variant.available %} disabled{% endunless %}>
      <span data-add-text>{% if current_variant.available %}{{ 'sections.product.add_to_cart' | t }}{% else %}{{ 'sections.product.sold_out' | t }}{% endif %}</span>
    </button>
    {%- if settings.enable_wishlist -%}
      <button type="button" class="btn-icon" data-wishlist-toggle data-handle="{{ product.handle }}" aria-label="{{ 'sections.product.add_to_wishlist' | t }}" aria-pressed="false">
        {%- render 'icon', icon: 'wishlist', width: 18, height: 18 -%}
      </button>
    {%- endif -%}
  </div>

  {%- if current_variant.available -%}
    {{ form | payment_button }}
  {%- else -%}
    <button type="button" class="btn btn-outline btn-block" disabled>{{ 'sections.product.unavailable' | t }}</button>
  {%- endif -%}
{%- endform -%}
</product-form>

{%- comment -%} Full variant + availability data for assets/product.js to drive live updates. {%- endcomment -%}
<script type="application/json" data-product-json>
  {{ product | json }}
</script>
