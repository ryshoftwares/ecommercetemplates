{%- comment -%}
  sections/main-404.liquid
  Ported from the demo's 404.html .error-page markup.
{%- endcomment -%}
<div class="error-page">
  <p class="error-code">404</p>
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.body }}</p>
  <div class="error-actions">
    <a href="{{ routes.root_url }}" class="btn btn-primary">{{ section.settings.home_button_text }}</a>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn-outline">{{ section.settings.shop_button_text }}</a>
  </div>
  {%- if section.settings.show_featured_collection and section.settings.featured_collection != blank -%}
    <div class="error-shop-suggest">
      <div class="section-head-center">
        <h2>{{ section.settings.featured_heading }}</h2>
      </div>
      <div class="product-grid">
        {%- for product in section.settings.featured_collection.products limit: 4 -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "404 page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page Not Found"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "The page you're looking for may have been moved or no longer exists. Try one of the links below, or search for what you need."
    },
    {
      "type": "text",
      "id": "home_button_text",
      "label": "Home button label",
      "default": "Back to Home"
    },
    {
      "type": "text",
      "id": "shop_button_text",
      "label": "Shop button label",
      "default": "Shop All"
    },
    {
      "type": "checkbox",
      "id": "show_featured_collection",
      "label": "Show a featured collection",
      "default": true
    },
    {
      "type": "text",
      "id": "featured_heading",
      "label": "Featured collection heading",
      "default": "You Might Like"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured collection"
    }
  ]
}
{% endschema %}
