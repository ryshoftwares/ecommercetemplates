{%- comment -%}
  sections/footer.liquid
  Ported 1:1 from the demo's .site-footer / .footer-grid markup: brand column
  with social row, block-based link columns (menu or custom text), and a
  newsletter column using Shopify's native customer newsletter form
  ({% form 'customer' %} with tag "newsletter", which Shopify recognises for
  its built-in subscriber list — no app required).
{%- endcomment -%}
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <span class="logo">{{ shop.name | upcase }}<span>.</span></span>
      <p>{{ section.settings.brand_text }}</p>
      <div class="social-row">
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" aria-label="Instagram">{%- render 'icon', icon: 'instagram', width: 16, height: 16 -%}</a>
        {%- endif -%}
        {%- if settings.social_pinterest_link != blank -%}
          <a href="{{ settings.social_pinterest_link }}" aria-label="Pinterest">{%- render 'icon', icon: 'pinterest', width: 16, height: 16 -%}</a>
        {%- endif -%}
        {%- if settings.social_facebook_link != blank -%}
          <a href="{{ settings.social_facebook_link }}" aria-label="Facebook">{%- render 'icon', icon: 'facebook', width: 16, height: 16 -%}</a>
        {%- endif -%}
        {%- if settings.social_twitter_link != blank -%}
          <a href="{{ settings.social_twitter_link }}" aria-label="X (Twitter)">{%- render 'icon', icon: 'twitter', width: 16, height: 16 -%}</a>
        {%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'menu_column' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            <ul>
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>

        {%- when 'text_column' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            <div class="footer-col-richtext">{{ block.settings.text }}</div>
          </div>

        {%- when 'newsletter' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            <p style="color:rgba(247,243,236,0.65);font-size:0.9rem;margin-bottom:12px">{{ block.settings.subtext }}</p>
            {%- form 'customer', class: 'footer-newsletter-form', style: 'display:flex;gap:8px' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <input type="email" name="contact[email]" required placeholder="{{ 'general.search.placeholder' | t }}" aria-label="Email" style="background:transparent;border:1px solid rgba(247,243,236,0.3);color:#F7F3EC;padding:10px;border-radius:4px;flex:1;min-height:44px" value="{% if customer %}{{ customer.email }}{% endif %}">
              <button type="submit" class="btn-icon" style="border-color:rgba(247,243,236,0.3);color:#F7F3EC" aria-label="Subscribe">&rarr;</button>
              {%- if form.posted_successfully? -%}
                <p class="form-success-message" data-toast-on-load="success:Thanks for subscribing to {{ shop.name }}."></p>
              {%- endif -%}
            {%- endform -%}
          </div>

      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="container footer-bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}</p>
    <div class="payment-icons">
      {%- for method in section.settings.payment_icons | split: ',' -%}
        <span>{{ method | strip }}</span>
      {%- endfor -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Brand description",
      "default": "Premium fashion for the woman who dresses with intention. Tailored dresses, outerwear, knitwear and accessories, made to last."
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "All rights reserved."
    },
    {
      "type": "text",
      "id": "payment_icons",
      "label": "Payment / trust badges (comma separated)",
      "default": "VISA, MASTERCARD, UPI, COD"
    }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text_column",
      "name": "Text column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Help" },
        { "type": "richtext", "id": "text", "label": "Content" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Newsletter" },
        { "type": "text", "id": "subtext", "label": "Subtext", "default": "Seasonal drops and styling notes, twice a month." }
      ]
    }
  ],
  "max_blocks": 6,
  "default": {
    "blocks": [
      {
        "type": "menu_column",
        "settings": { "heading": "Shop", "menu": "footer" }
      },
      {
        "type": "text_column",
        "settings": {
          "heading": "Help",
          "text": "<ul><li><a href=\"/pages/contact\">Contact Us</a></li><li><a href=\"/pages/shipping\">Shipping</a></li><li><a href=\"/pages/returns\">Returns</a></li><li><a href=\"/search\">Search</a></li></ul>"
        }
      },
      {
        "type": "text_column",
        "settings": {
          "heading": "Company",
          "text": "<ul><li><a href=\"/pages/about\">About Velora</a></li><li><a href=\"/pages/about#values\">Sustainability</a></li><li><a href=\"/pages/contact\">Careers</a></li></ul>"
        }
      },
      {
        "type": "newsletter",
        "settings": { "heading": "Newsletter", "subtext": "Seasonal drops and styling notes, twice a month." }
      }
    ]
  }
}
{% endschema %}
