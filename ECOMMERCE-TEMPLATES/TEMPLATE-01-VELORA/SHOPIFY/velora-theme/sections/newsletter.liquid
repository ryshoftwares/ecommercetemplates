{%- comment -%}
  sections/newsletter.liquid
  Standalone newsletter section (homepage / about page), ported from the
  demo's .newsletter block. Uses Shopify's native customer newsletter form —
  {% form 'customer' %} with contact[tags] = "newsletter", which Shopify's
  built-in subscriber list recognises without any app.
{%- endcomment -%}
<section class="newsletter reveal">
  <div class="container">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.body }}</p>
    {%- form 'customer', class: 'newsletter-form', data-newsletter-form: '' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" required placeholder="{{ section.settings.placeholder }}" aria-label="Email address" value="{% if customer %}{{ customer.email }}{% endif %}">
      <button type="submit" class="btn btn-ivory">{{ section.settings.button_text }}</button>
      {%- if form.posted_successfully? -%}
        <p class="form-success-message" data-toast-on-load="success:Thanks for subscribing to {{ shop.name }}."></p>
      {%- endif -%}
      {%- if form.errors -%}
        <p class="field-error" style="display:block">{{ form.errors.messages.first }}</p>
      {%- endif -%}
    {%- endform -%}
    <p class="newsletter-note">{{ section.settings.disclaimer }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Velora List"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Be first to hear about new collections, private sales and styling notes from our design team."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email input placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "By subscribing you agree to receive marketing emails from Velora. Unsubscribe anytime."
    }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "settings": {
        "heading": "Join the Velora List",
        "body": "Be first to hear about new collections, private sales and styling notes from our design team.",
        "placeholder": "Your email address",
        "button_text": "Subscribe",
        "disclaimer": "By subscribing you agree to receive marketing emails from Velora. Unsubscribe anytime."
      }
    }
  ]
}
{% endschema %}
