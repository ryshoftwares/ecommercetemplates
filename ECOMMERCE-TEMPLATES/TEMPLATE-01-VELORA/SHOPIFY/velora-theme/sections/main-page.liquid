{%- comment -%}
  sections/main-page.liquid
  Generic page content section (About / Contact / policy-style pages),
  referenced by templates/page.json. Renders the page's real title +
  page.content richtext inside the demo's .page-band + container pattern.
  For a fuller editorial "About" page, add sections/image-with-text.liquid,
  sections/editorial-quote.liquid and sections/newsletter.liquid as extra
  sections on that page's template in the theme editor — they are all
  reusable and already match the demo's about.html visual language.
{%- endcomment -%}
<div class="page-band">
  <div class="container">
    {%- render 'breadcrumb' -%}
    <h1>{{ page.title }}</h1>
  </div>
</div>
<div class="container" style="padding:var(--sp-8) 0">
  <div class="rte" style="max-width:760px;margin:0 auto">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Page"
}
{% endschema %}
