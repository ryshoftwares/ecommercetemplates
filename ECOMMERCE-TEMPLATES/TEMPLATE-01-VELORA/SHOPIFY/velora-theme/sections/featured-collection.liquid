{%- comment -%}
  sections/featured-collection.liquid
  Used for both "New Arrivals" and "Best Sellers" on the homepage (and can be
  reused anywhere), ported from the demo's .product-grid section pattern.
  Renders real {% for product in collection.products %} via
  snippets/product-card.liquid — never hardcoded products.
{%- endcomment -%}
<section class="section-pad{% if section.settings.tight_top %} pt-0{% endif %} reveal">
  <div class="container">
    <div class="section-head">
      <div class="intro">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.collection != blank -%}
        <a href="{{ section.settings.collection.url }}" class="btn-text">{{ section.settings.view_all_text }} &rarr;</a>
      {%- endif -%}
    </div>

    {%- if section.settings.collection != blank -%}
      <div class="product-grid" style="grid-template-columns:repeat({{ section.settings.columns }},1fr)" data-featured-collection-grid>
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="empty-state">
        <p class="text-muted">Select a collection in the theme editor to show products here.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Just Landed"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "\"View all\" link text",
      "default": "Shop All"
    },
    {
      "type": "checkbox",
      "id": "tight_top",
      "label": "Remove top padding (use directly under another section)",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Featured collection",
      "settings": {
        "eyebrow": "Just Landed",
        "heading": "New Arrivals",
        "products_to_show": 4,
        "columns": 4,
        "view_all_text": "Shop All"
      }
    }
  ]
}
{% endschema %}
