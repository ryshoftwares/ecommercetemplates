{%- comment -%}
  sections/main-wishlist.liquid
  Wishlist page, referenced by templates/page.wishlist.json — assign this
  alternate template to a Page titled "Wishlist" in Admin > Online Store >
  Pages (Template: page.wishlist) to publish it at /pages/wishlist, matching
  the header's wishlist link fallback in sections/header.liquid.

  Shopify has no native wishlist object. This shell is empty on the server;
  assets/theme.js reads the saved product handles from localStorage
  ("velora_wishlist_v1"), fetches each product's live JSON from
  `/products/{handle}.js`, and renders the product-card markup client-side —
  mirroring the demo's js/wishlist.js renderWishlistPage().
{%- endcomment -%}
<div class="page-band">
  <div class="container">
    {%- render 'breadcrumb' -%}
    <h1>{{ 'sections.wishlist.title' | t }}</h1>
  </div>
</div>

<div class="container" style="padding:var(--sp-8) 0" data-wishlist-page>
  <div class="wishlist-toolbar">
    <span class="result-count"><span data-wishlist-page-count>0</span> {{ 'sections.wishlist.saved_items' | t: count: '' }}</span>
  </div>
  <div class="empty-state" data-wishlist-empty style="display:none">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" width="64" height="64"><path d="M12 21s-7.5-4.6-10-9.2C0.3 8.3 2 4.5 5.7 4c2-.3 3.7.7 4.9 2.3C11.8 4.7 13.5 3.7 15.5 4c3.7.5 5.4 4.3 3.7 7.8C20 16.4 12 21 12 21z"/></svg>
    <h3>{{ 'sections.wishlist.empty_title' | t }}</h3>
    <p class="text-muted">{{ 'sections.wishlist.empty_body' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">{{ 'sections.wishlist.discover' | t }}</a>
  </div>
  <div class="product-grid" data-wishlist-grid></div>
</div>

{% schema %}
{
  "name": "Wishlist page"
}
{% endschema %}
