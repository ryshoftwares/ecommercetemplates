{%- comment -%}
  sections/promo-banner.liquid
  Seasonal promo/campaign banner, ported from the demo's
  .promo-banner / .promo-banner__content markup (index.html "Seasonal Sale"
  block) including the decorative live countdown
  (assets/theme.js initPromoCountdown, unchanged behavior from the demo's
  js/app.js — counts down to a merchant-set end date/time rather than a
  fixed "+5 days" offset, so it stays accurate however long the section is
  left on the page).
{%- endcomment -%}
<section class="container section--tight">
  <div class="promo-banner reveal" data-reveal{% if section.settings.end_datetime != blank %} data-promo-end="{{ section.settings.end_datetime }}"{% endif %}>
    {%- if section.settings.image -%}
      <img src="{{ section.settings.image | image_url: width: 1600 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" width="1600" height="560" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-3' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
    <div class="promo-banner__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
      {%- if section.settings.show_countdown and section.settings.end_datetime != blank -%}
        <div class="promo-countdown" data-promo-countdown></div>
      {%- endif -%}
      {%- if section.settings.cta_text != blank -%}
        <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}" class="btn btn--primary">{{ section.settings.cta_text }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Seasonal Sale"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Up to 15% off select pieces"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "For a limited time, save on lounge chairs, lighting and decor across the Ardea collection. Ends soon."
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown timer",
      "default": true
    },
    {
      "type": "text",
      "id": "end_datetime",
      "label": "Countdown end date/time",
      "info": "ISO format, e.g. 2026-09-01T23:59:00. Leave blank to hide the countdown even if enabled above.",
      "default": ""
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button label",
      "default": "Shop the Sale"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Promo banner",
      "settings": {
        "eyebrow": "Seasonal Sale",
        "heading": "Up to 15% off select pieces",
        "subheading": "For a limited time, save on lounge chairs, lighting and decor across the Ardea collection. Ends soon.",
        "show_countdown": true,
        "cta_text": "Shop the Sale"
      }
    }
  ]
}
{% endschema %}
