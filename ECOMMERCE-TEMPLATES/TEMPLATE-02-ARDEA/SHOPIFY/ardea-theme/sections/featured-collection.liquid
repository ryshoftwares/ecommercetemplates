{%- comment -%}
  sections/featured-collection.liquid
  Used for both "New Arrivals" and "Best Sellers" on the homepage (and can be
  reused anywhere), ported from the demo's .product-grid section pattern
  (data-new-arrivals / data-best-sellers). Renders real
  {% for product in collection.products %} via snippets/product-card.liquid
  — never hardcoded products. Point "New Arrivals" at a collection sorted
  by "Date, new to old" and "Best Sellers" at one sorted by "Best selling"
  in Shopify Admin > Collections.
{%- endcomment -%}
<section class="section{% if section.settings.alt_background %} section--alt{% endif %}{% if section.settings.tight_top %} section--tight{% endif %}">
  <div class="container">
    <div class="section-head reveal" data-reveal>
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.collection != blank -%}
        <a href="{{ section.settings.collection.url }}" class="btn btn--outline">{{ section.settings.view_all_text }}</a>
      {%- endif -%}
    </div>

    {%- if section.settings.collection != blank -%}
      <div class="product-grid reveal" data-reveal style="grid-template-columns:repeat({{ section.settings.columns }},1fr)">
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="empty-state">
        <p style="color:var(--color-text-muted);">Select a collection in the theme editor to show pieces here.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Just Landed"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "\"View all\" link text",
      "default": "Shop New Arrivals"
    },
    {
      "type": "checkbox",
      "id": "alt_background",
      "label": "Use sand (alt) background",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "tight_top",
      "label": "Use tight vertical padding",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Featured collection",
      "settings": {
        "eyebrow": "Just Landed",
        "heading": "New Arrivals",
        "products_to_show": 4,
        "columns": 4,
        "view_all_text": "Shop New Arrivals"
      }
    }
  ]
}
{% endschema %}
