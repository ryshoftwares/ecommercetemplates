{%- comment -%}
  sections/testimonials.liquid ("In Their Words" reviews)
  Ported from the demo's .review-grid / .review-card markup. Uses static,
  merchant-editable blocks (quote/author/rating/product) rather than
  assuming a reviews app is installed — the no-app-required approach. The
  demo's js/products.js explicitly flags its REVIEWS array as sample data to
  be replaced with a real reviews feed in production; this section is that
  replacement surface. If a reviews app (Judge.me/Loox/etc.) is later
  installed, swap this section's blocks for that app's Liquid embed block
  without touching the rest of the theme.
{%- endcomment -%}
<section class="section container">
  <div class="section-head reveal" data-reveal>
    <div class="section-head__text">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
  </div>
  <div class="review-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'review' -%}
        <div class="review-card reveal" data-reveal {{ block.shopify_attributes }}>
          <div class="review-card__stars stars">{% for i in (1..5) %}<svg class="star{% if i <= block.settings.rating %} star--full{% endif %}" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.5l2.7 5.9 6.3.6-4.8 4.3 1.4 6.2L10 15.6l-5.6 2.9 1.4-6.2L1 8l6.3-.6z"/></svg>{% endfor %}</div>
          <h4 class="review-card__title">{{ block.settings.title }}</h4>
          <p class="review-card__body">{{ block.settings.body }}</p>
          <div class="review-card__meta">
            <strong>{{ block.settings.author }}</strong>
            <span>{{ block.settings.location }}</span>
          </div>
          {%- if block.settings.product_name != blank -%}
            <p class="review-card__product" style="margin-top:0.5rem;font-size:0.8rem;">On {{ block.settings.product_name }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "In Their Words"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved in living rooms across India"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        { "type": "text", "id": "title", "label": "Review title" },
        { "type": "textarea", "id": "body", "label": "Review body" },
        { "type": "text", "id": "author", "label": "Author name" },
        { "type": "text", "id": "location", "label": "Author location", "default": "Verified Buyer" },
        { "type": "text", "id": "product_name", "label": "Product name (optional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Exactly as described, and then some",
            "body": "The Oak Lounge Chair is the first piece of furniture we've bought that feels like it was actually built by someone, not stamped out. The oil finish smell on arrival was lovely too.",
            "author": "Priya M.",
            "location": "Bengaluru"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Sofa arrived faster than expected",
            "body": "Was ready for a long wait given it's made to order, but the sofa arrived in three weeks and the two-person delivery team was careful and quick.",
            "author": "Rohit K.",
            "location": "Pune"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 4,
            "title": "Beautiful grain, needs a coaster habit",
            "body": "The walnut coffee table looks stunning in person — just make sure everyone in the house uses coasters, the live edge shows every ring if you don't.",
            "author": "Ananya S.",
            "location": "Mumbai"
          }
        }
      ]
    }
  ]
}
{% endschema %}
