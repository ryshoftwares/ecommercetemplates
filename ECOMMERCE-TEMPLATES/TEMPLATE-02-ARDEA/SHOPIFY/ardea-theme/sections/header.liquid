{%- comment -%}
  sections/header.liquid
  Ardea's two-row header, ported 1:1 from the demo's .site-header /
  .header-row markup: hamburger + logo left, primary nav centered
  (grid-template-columns: 1fr auto 1fr), utility icons (search / account /
  wishlist / cart) right. The topbar above it is a separate section
  (sections/announcement-bar.liquid).

  MEGA MENU: the "Shop" top-level link is expected to have child links (one
  per room — Living Room, Bedroom, Kitchen, Lighting, Decor), each of which
  may itself have grandchild links (e.g. Living Room > Lounge Chairs, Sofas,
  Coffee Tables), matching the demo's five .mega-menu__group columns. Build
  this nesting in Online Store > Navigation for the menu assigned below.
  Any other top-level link with no children renders as a plain nav link.

  WISHLIST: Shopify has no native wishlist object/API. The heart icon + count
  badge below are driven entirely client-side by assets/theme.js
  (window.Ardea.wishlist), which stores an array of product handles in
  localStorage ("ardea_wishlist_v1") — see settings_schema.json > Wishlist.
{%- endcomment -%}
{%- liquid
  assign menu = linklists[section.settings.menu]
-%}
<header class="site-header" data-site-header>
  <div class="container header-row">
    <div class="header-row__start">
      <button type="button" class="hamburger" data-mobile-nav-open aria-label="{{ 'sections.header.open_menu' | t }}" aria-expanded="false" aria-controls="mobileDrawer">
        <span class="hamburger__box"><span class="hamburger__line"></span><span class="hamburger__line"></span><span class="hamburger__line"></span></span>
      </button>
      {%- liquid
        assign header_logo = section.settings.logo | default: settings.logo
        assign header_logo_width = section.settings.logo_width | default: settings.logo_width
      -%}
      <a href="{{ routes.root_url }}" class="logo">
        {%- if header_logo -%}
          <img src="{{ header_logo | image_url: width: 400 }}" alt="{{ shop.name }}" width="{{ header_logo_width }}" style="width:{{ header_logo_width }}px; height:auto;">
        {%- else -%}
          {{ shop.name | upcase }}<span>.</span>
        {%- endif -%}
      </a>
    </div>

    <nav class="main-nav" aria-label="Primary">
      <ul class="main-nav__list">
        {%- for link in menu.links -%}
          <li class="main-nav__item"{% if link.links.size > 0 %} data-has-mega{% endif %}>
            <a href="{{ link.url }}" class="main-nav__link"{% if link.links.size > 0 %} aria-haspopup="true"{% endif %}>
              {{ link.title }}
              {%- if link.links.size > 0 -%}{%- render 'icon', icon: 'chevron', width: 10, height: 10 -%}{%- endif -%}
            </a>
            {%- if link.links.size > 0 -%}
              <div class="mega-menu">
                {%- for room_link in link.links -%}
                  <div class="mega-menu__group">
                    <h4>{{ room_link.title }}</h4>
                    <ul>
                      <li><a href="{{ room_link.url }}">All {{ room_link.title }}</a></li>
                      {%- for sub_link in room_link.links -%}
                        <li><a href="{{ sub_link.url }}">{{ sub_link.title }}</a></li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header-row__end">
      {%- if section.settings.show_search -%}
        <button type="button" class="icon-btn header-search" data-search-open aria-label="{{ 'general.search.open' | t }}">
          {%- render 'icon', icon: 'search', width: 21, height: 21 -%}
        </button>
      {%- endif -%}
      {%- if section.settings.show_account -%}
        <a href="{{ routes.account_url }}" class="icon-btn header-account" aria-label="{{ 'sections.header.account' | t }}">
          {%- render 'icon', icon: 'account', width: 21, height: 21 -%}
        </a>
      {%- endif -%}
      {%- if section.settings.show_wishlist and settings.enable_wishlist -%}
        <a href="{{ pages.wishlist.url | default: '/pages/wishlist' }}" class="icon-btn" data-wishlist-link aria-label="{{ 'sections.header.wishlist' | t }}">
          {%- render 'icon', icon: 'wishlist', width: 21, height: 21 -%}
          <span class="count-badge" data-wishlist-count style="display:none;">0</span>
        </a>
      {%- endif -%}
      {%- if section.settings.show_cart -%}
        <button type="button" class="icon-btn" data-cart-open aria-label="{{ 'sections.header.cart' | t }}">
          {%- render 'icon', icon: 'cart', width: 21, height: 21 -%}
          <span class="count-badge" data-cart-count{% if cart.item_count == 0 %} style="display:none;"{% endif %}>{{ cart.item_count }}</span>
        </button>
      {%- endif -%}
    </div>
  </div>
</header>

<div class="mobile-drawer" data-mobile-drawer id="mobileDrawer">
  <div class="drawer__header">
    <a href="{{ routes.root_url }}" class="logo">{{ shop.name | upcase }}<span>.</span></a>
    <button type="button" class="icon-btn" data-panel-close aria-label="{{ 'sections.header.close_menu' | t }}">
      {%- render 'icon', icon: 'close', width: 22, height: 22 -%}
    </button>
  </div>
  <div class="drawer__body">
    <nav class="mobile-nav" aria-label="Mobile primary">
      {%- for link in menu.links -%}
        {%- if link.links.size > 0 -%}
          <div class="mobile-nav__item">
            <button type="button" class="mobile-nav__toggle">{{ link.title }} {%- render 'icon', icon: 'chevron', width: 14, height: 14 -%}</button>
            <div class="mobile-nav__panel"><div class="mobile-nav__panel-inner">
              {%- for room_link in link.links -%}
                <a href="{{ room_link.url }}">{{ room_link.title }}</a>
              {%- endfor -%}
              <a href="{{ link.url }}">{{ section.settings.shop_all_text }}</a>
            </div></div>
          </div>
        {%- else -%}
          <a href="{{ link.url }}" class="mobile-nav__link">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  </div>
  <div class="drawer__footer">
    {%- if settings.enable_wishlist -%}<a href="{{ pages.wishlist.url | default: '/pages/wishlist' }}">{{ 'sections.header.wishlist' | t }}</a>{%- endif -%}
    <a href="{{ routes.account_url }}">{{ 'sections.header.account' | t }}</a>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Optional — falls back to the shop name as a wordmark ('ARDEA.'), matching the demo."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu",
      "info": "Give the first link (e.g. \"Shop\") child links per room, and grandchild links per product type, to populate the mega menu."
    },
    {
      "type": "text",
      "id": "shop_all_text",
      "label": "Mobile drawer \"Shop all\" link text",
      "default": "Shop All"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart icon",
      "default": true
    }
  ]
}
{% endschema %}
