{%- comment -%}
  sections/testimonials.liquid
  Block-based quotes + rating, ported 1:1 from the demo's .reviews-summary /
  .reviews-grid / .review-card markup. The aggregate score/count at the top
  are merchant-entered settings (no reviews app assumed) — swap for a real
  reviews app's aggregate feed if one is installed.
{%- endcomment -%}
<section class="section" data-reveal>
  <div class="container">
    <div class="reviews-summary">
      <span class="reviews-summary__score">{{ section.settings.average_rating }}</span>
      <div>
        <span class="rating__stars" aria-hidden="true" style="color:var(--color-star);display:inline-flex;gap:2px;">
          {%- assign rating_rounded = section.settings.average_rating | round -%}
          {%- for i in (1..5) -%}<svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14" style="opacity:{% if i <= rating_rounded %}1{% else %}0.28{% endif %}"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6z"/></svg>{%- endfor -%}
        </span>
        <p style="margin-top:4px;">{{ section.settings.review_summary_text }}</p>
      </div>
    </div>
    <div class="reviews-grid">
      {%- for block in section.blocks -%}
        <article class="review-card" {{ block.shopify_attributes }}>
          <span class="rating__stars" aria-hidden="true" style="color:var(--color-star);">
            {%- for i in (1..5) -%}<svg viewBox="0 0 20 20" fill="currentColor" width="13" height="13" style="opacity:{% if i <= block.settings.rating %}1{% else %}0.28{% endif %}"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6z"/></svg>{%- endfor -%}
          </span>
          <p class="review-card__quote">"{{ block.settings.quote }}"</p>
          <div class="review-card__meta">
            <span class="review-card__avatar">{{ block.settings.author | slice: 0, 1 }}</span>
            <div>
              <div class="review-card__name">{{ block.settings.author }}</div>
              <div class="review-card__product">{{ block.settings.product_name }}</div>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "average_rating", "label": "Average rating", "default": "4.6" },
    { "type": "text", "id": "review_summary_text", "label": "Summary text", "default": "Based on 4,300+ verified Modix customer reviews" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Author name" },
        { "type": "text", "id": "product_name", "label": "Product referenced" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Testimonials",
      "settings": {
        "average_rating": "4.6",
        "review_summary_text": "Based on 4,300+ verified Modix customer reviews"
      },
      "blocks": [
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "The over-ear headphones' ANC is genuinely as good as the spec sheet claims — I use them on every flight now.",
            "author": "Rohan K.",
            "product_name": "Wireless Headphones"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "Switched from another brand to a Modix laptop for uni — fanless, silent, and the battery genuinely lasts all day.",
            "author": "Sanya M.",
            "product_name": "Everyday Laptop"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "The smart speaker and bulb kit set up in ten minutes and the voice control actually works reliably — no dropped commands.",
            "author": "Arjun P.",
            "product_name": "Smart Home Speaker"
          }
        }
      ]
    }
  ]
}
{% endschema %}
