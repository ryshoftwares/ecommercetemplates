{%- comment -%}
  sections/header.liquid
  Bold-logo-left MODIX header, ported 1:1 from the demo's index.html markup:
  dark charcoal .utility-strip (support/track-order links + free-shipping
  note) sits above the sticky .site-header, whose .header-bar shrinks in
  height (--header-h -> --header-h-collapsed) once assets/theme.js adds
  .is-scrolled — matching the demo's js/app.js initHeaderCollapse exactly
  (the utility strip itself does not hide on scroll in the master demo; it
  is simply not shown below the 768px breakpoint, per css/responsive.css).

  MEGA MENU: menu.links with children render a two-column .mega-panel — the
  left column lists the linklist's own child links (Shopify-native,
  editable in Online Store > Navigation) plus a "View All" link; the right
  column shows up to 3 merchant-picked "featured products" with mini spec
  chips, sourced from a matching block below (matched by exact top-level
  link title, mirroring the demo's per-category .mega-product cards).
  Spec chips are read from each product's real
  product.metafields.custom.specifications JSON metafield (see
  snippets/spec-table.liquid) — never hardcoded copy.

  WISHLIST: Shopify has no native wishlist object/API. The heart icon +
  count badge below are driven entirely client-side by assets/theme.js
  (window.Modix.wishlist), which stores an array of product handles in
  localStorage ("modix_wishlist_v1") — see settings_schema.json > Wishlist.
{%- endcomment -%}
{%- liquid
  assign menu = linklists[section.settings.menu]
-%}
<div class="utility-strip">
  <div class="container">
    <div class="utility-strip__links">
      <a href="{{ section.settings.support_url | default: '/pages/contact' }}">{{ section.settings.support_text }}</a>
      <span class="utility-strip__divider">|</span>
      <a href="{{ section.settings.track_order_url | default: '/pages/contact' }}">{{ section.settings.track_order_text }}</a>
    </div>
    <div class="utility-strip__meta">
      <span>{{ section.settings.free_shipping_text }}</span>
      <span class="utility-strip__divider">|</span>
      <a href="{{ section.settings.story_url | default: '/pages/about' }}">{{ section.settings.story_text }}</a>
    </div>
  </div>
</div>

<header class="site-header" data-site-header>
  <div class="container header-bar">
    <button class="icon-btn mobile-toggle" type="button" data-mobile-toggle aria-expanded="false" aria-label="{{ 'sections.header.open_menu' | t }}">
      {%- render 'icon', icon: 'menu', width: 22, height: 22 -%}
    </button>

    {%- liquid
      assign header_logo = section.settings.logo | default: settings.logo
      assign header_logo_width = section.settings.logo_width | default: settings.logo_width
    -%}
    <a href="{{ routes.root_url }}" class="logo">
      {%- if header_logo -%}
        <img src="{{ header_logo | image_url: width: 400 }}" alt="{{ shop.name }}" width="{{ header_logo_width }}" style="width:{{ header_logo_width }}px;height:auto;">
      {%- else -%}
        {{ shop.name | upcase }}<span class="logo__dot">.</span>
      {%- endif -%}
    </a>

    <nav class="main-nav" aria-label="Primary">
      <ul class="nav-list">
        {%- for link in menu.links -%}
          <li class="nav-item{% if link.links.size > 0 %} has-mega{% endif %}">
            <a href="{{ link.url }}" class="nav-link">{{ link.title }}
              {%- if link.links.size > 0 -%} {%- render 'icon', icon: 'chevron', width: 10, height: 10 -%}{%- endif -%}
            </a>
            {%- if link.links.size > 0 -%}
              {%- liquid
                assign mega_block = blank
                for block in section.blocks
                  if block.type == 'mega_menu_products' and block.settings.menu_item_title == link.title
                    assign mega_block = block
                  endif
                endfor
              -%}
              <div class="mega-panel">
                <div class="mega-panel__inner">
                  <div class="mega-panel__links">
                    <span class="mega-panel__title">Browse {{ link.title }}</span>
                    <a href="{{ link.url }}">Shop All {{ link.title }}</a>
                    {%- for sub_link in link.links -%}
                      <a href="{{ sub_link.url }}">{{ sub_link.title }}</a>
                    {%- endfor -%}
                    <a href="{{ link.url }}" class="is-viewall">View All {{ link.title }} →</a>
                  </div>
                  {%- if mega_block -%}
                    <div class="mega-panel__products">
                      {%- for i in (1..3) -%}
                        {%- assign mega_product = mega_block.settings['product_' | append: i] -%}
                        {%- if mega_product != blank -%}
                          {%- liquid
                            assign specs_json = mega_product.metafields.custom.specifications.value
                            assign specs = blank
                            if specs_json != blank
                              assign specs = specs_json | parse_json
                            endif
                          -%}
                          <a class="mega-product" href="{{ mega_product.url }}">
                            <div class="mega-product__image">
                              {%- if mega_product.featured_media -%}
                                <img src="{{ mega_product.featured_media | image_url: width: 240 }}" alt="{{ mega_product.title | escape }}" width="120" height="120" loading="lazy">
                              {%- endif -%}
                            </div>
                            <div class="mega-product__name">{{ mega_product.title }}</div>
                            {%- if specs.size > 0 -%}
                              <div class="mega-product__chips">
                                {%- for spec in specs limit: 2 -%}<span class="spec-chip">{{ spec.value }}</span>{%- endfor -%}
                              </div>
                            {%- endif -%}
                            <div class="mega-product__price">{{ mega_product.price | money }}</div>
                          </a>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header-actions">
      {%- if section.settings.show_search -%}
        <button class="icon-btn" type="button" data-search-open aria-label="{{ 'general.search.open' | t }}">{%- render 'icon', icon: 'search', width: 20, height: 20 -%}</button>
      {%- endif -%}
      {%- if section.settings.show_account -%}
        <button class="icon-btn" type="button" data-account-trigger aria-label="{{ 'sections.header.account' | t }}">{%- render 'icon', icon: 'account', width: 20, height: 20 -%}</button>
      {%- endif -%}
      {%- if section.settings.show_wishlist and settings.enable_wishlist -%}
        <a class="icon-btn" href="{{ pages.wishlist.url | default: '/pages/wishlist' }}" aria-label="{{ 'sections.header.wishlist' | t }}">
          {%- render 'icon', icon: 'wishlist', width: 20, height: 20 -%}
          <span class="icon-btn__badge" data-wishlist-count style="display:none">0</span>
        </a>
      {%- endif -%}
      {%- if section.settings.show_cart -%}
        <button class="icon-btn" type="button" data-cart-open aria-label="{{ 'sections.header.cart' | t }}">
          {%- render 'icon', icon: 'cart', width: 20, height: 20 -%}
          <span class="icon-btn__badge" data-cart-count{% if cart.item_count == 0 %} style="display:none"{% endif %}>{{ cart.item_count }}</span>
        </button>
      {%- endif -%}
    </div>

    <div class="mobile-header">
      {%- if section.settings.show_cart -%}
        <button class="icon-btn" type="button" data-cart-open aria-label="{{ 'sections.header.cart' | t }}">
          {%- render 'icon', icon: 'cart', width: 20, height: 20 -%}
          <span class="icon-btn__badge" data-cart-count{% if cart.item_count == 0 %} style="display:none"{% endif %}>{{ cart.item_count }}</span>
        </button>
      {%- endif -%}
    </div>
  </div>
</header>

<div class="overlay-scrim" data-drawer-scrim></div>
<nav class="mobile-drawer" aria-label="Mobile menu" data-mobile-drawer>
  <div class="mobile-drawer__header">
    <a href="{{ routes.root_url }}" class="logo">{{ shop.name | upcase }}<span class="logo__dot">.</span></a>
    <button class="icon-btn" type="button" data-mobile-drawer-close aria-label="{{ 'sections.header.close_menu' | t }}">{%- render 'icon', icon: 'close', width: 20, height: 20 -%}</button>
  </div>
  <div style="padding:16px 20px;">
    <button class="btn btn-ghost btn-block" type="button" data-search-open>
      {%- render 'icon', icon: 'search', width: 18, height: 18 -%} {{ 'general.search.placeholder' | t }}
    </button>
  </div>
  <ul class="mobile-drawer__list">
    {%- for link in menu.links -%}
      {%- if link.links.size > 0 -%}
        <li>
          <button class="mobile-drawer__link" type="button" data-submenu-toggle aria-expanded="false" aria-controls="submenu-{{ forloop.index }}">{{ link.title }} {%- render 'icon', icon: 'chevron', width: 14, height: 14 -%}</button>
          <div class="mobile-drawer__submenu" id="submenu-{{ forloop.index }}">
            <a href="{{ link.url }}">Shop All {{ link.title }}</a>
            {%- for sub_link in link.links -%}<a href="{{ sub_link.url }}">{{ sub_link.title }}</a>{%- endfor -%}
          </div>
        </li>
      {%- else -%}
        <li><a class="mobile-drawer__link" href="{{ link.url }}">{{ link.title }}</a></li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
  <div class="mobile-drawer__footer">
    <a href="{{ pages.wishlist.url | default: '/pages/wishlist' }}" class="btn btn-ghost btn-block">{{ 'sections.header.wishlist' | t }}</a>
    <a href="{{ pages.contact.url | default: '/pages/contact' }}" class="btn btn-ghost btn-block">{{ 'sections.header.support' | t }}</a>
  </div>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Optional — falls back to the shop name as a bold wordmark (\"MODIX.\"), matching the demo."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 130
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu",
      "info": "Give each top-level link (Audio / Smartphones / Laptops / Smart Home / Wearables) child links to populate its mega panel's left column."
    },
    {
      "type": "header",
      "content": "Utility strip"
    },
    { "type": "text", "id": "support_text", "label": "Support link text", "default": "Support" },
    { "type": "url", "id": "support_url", "label": "Support link" },
    { "type": "text", "id": "track_order_text", "label": "Track order link text", "default": "Track Order" },
    { "type": "url", "id": "track_order_url", "label": "Track order link" },
    { "type": "text", "id": "free_shipping_text", "label": "Free shipping note", "default": "Free shipping over ₹2,999" },
    { "type": "text", "id": "story_text", "label": "Our story link text", "default": "Our Story" },
    { "type": "url", "id": "story_url", "label": "Our story link" },
    {
      "type": "header",
      "content": "Icons"
    },
    { "type": "checkbox", "id": "show_search", "label": "Show search icon", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account icon", "default": true },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist icon", "default": true },
    { "type": "checkbox", "id": "show_cart", "label": "Show cart icon", "default": true }
  ],
  "blocks": [
    {
      "type": "mega_menu_products",
      "name": "Mega menu — featured products",
      "settings": [
        {
          "type": "text",
          "id": "menu_item_title",
          "label": "Matching top-level menu title",
          "info": "Must exactly match one top-level link's title in the menu above (e.g. \"Audio\") so its mega panel shows these products."
        },
        { "type": "product", "id": "product_1", "label": "Featured product 1" },
        { "type": "product", "id": "product_2", "label": "Featured product 2" },
        { "type": "product", "id": "product_3", "label": "Featured product 3" }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
