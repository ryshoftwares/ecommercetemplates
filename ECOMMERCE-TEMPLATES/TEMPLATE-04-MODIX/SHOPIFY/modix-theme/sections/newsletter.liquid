{%- comment -%}
  sections/newsletter.liquid
  Standalone centered newsletter section, ported 1:1 from the demo's
  .newsletter markup, using Shopify's native customer form (tag
  "newsletter") — no app required, real subscribers land in Shopify Admin.
{%- endcomment -%}
<section class="section section--alt newsletter" data-reveal>
  <div class="container">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow" style="justify-content:center;">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.body }}</p>
    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">Email address</label>
      <input type="email" id="NewsletterEmail-{{ section.id }}" name="contact[email]" placeholder="you@example.com" required value="{% if customer %}{{ customer.email }}{% endif %}">
      <button type="submit" class="btn btn-primary">{{ section.settings.button_text }}</button>
      {%- if form.posted_successfully? -%}
        <p data-toast-on-load="success:Thanks for joining the Modix insider list."></p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Stay Updated" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get early access to new Modix drops" },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "Product launches, firmware updates and members-only pricing — no spam, unsubscribe any time." },
    { "type": "text", "id": "button_text", "label": "Button label", "default": "Subscribe" }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "settings": {
        "eyebrow": "Stay Updated",
        "heading": "Get early access to new Modix drops",
        "body": "Product launches, firmware updates and members-only pricing — no spam, unsubscribe any time.",
        "button_text": "Subscribe"
      }
    }
  ]
}
{% endschema %}
