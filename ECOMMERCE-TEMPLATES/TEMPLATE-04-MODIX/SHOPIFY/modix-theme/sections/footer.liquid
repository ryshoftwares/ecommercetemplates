{%- comment -%}
  sections/footer.liquid
  Ported 1:1 from the demo's .site-footer / .footer-top / .footer-trust
  markup: brand column with social row + trust list, block-based link
  columns (menu or custom text), and a native customer newsletter form
  ({% form 'customer' %} with tag "newsletter", which Shopify recognises for
  its built-in subscriber list — no app required).
{%- endcomment -%}
<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a href="{{ routes.root_url }}" class="logo">{{ shop.name | upcase }}<span class="logo__dot">.</span></a>
      <p>{{ section.settings.brand_text }}</p>
      <div class="footer-social">
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Modix on Instagram">{%- render 'icon', icon: 'instagram', width: 16, height: 16 -%}</a>
        {%- endif -%}
        {%- if settings.social_twitter_link != blank -%}
          <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener" aria-label="Modix on X">{%- render 'icon', icon: 'twitter', width: 16, height: 16 -%}</a>
        {%- endif -%}
        {%- if settings.social_youtube_link != blank -%}
          <a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener" aria-label="Modix on YouTube">{%- render 'icon', icon: 'youtube', width: 16, height: 16 -%}</a>
        {%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'menu_column' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            <ul>
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>

        {%- when 'text_column' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            <ul>{{ block.settings.text }}</ul>
          </div>

        {%- when 'trust_column' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            <ul class="footer-trust">
              {%- if block.settings.trust_1 != blank -%}<li>{%- render 'icon', icon: 'warranty', width: 16, height: 16 -%} {{ block.settings.trust_1 }}</li>{%- endif -%}
              {%- if block.settings.trust_2 != blank -%}<li>{%- render 'icon', icon: 'truck', width: 16, height: 16 -%} {{ block.settings.trust_2 }}</li>{%- endif -%}
              {%- if block.settings.trust_3 != blank -%}<li>{%- render 'icon', icon: 'returns', width: 16, height: 16 -%} {{ block.settings.trust_3 }}</li>{%- endif -%}
              {%- if block.settings.trust_4 != blank -%}<li>{%- render 'icon', icon: 'shield', width: 16, height: 16 -%} {{ block.settings.trust_4 }}</li>{%- endif -%}
            </ul>
          </div>

        {%- when 'newsletter' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            {%- form 'customer', class: 'newsletter__form', style: 'margin-top:16px;max-width:none;' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label class="visually-hidden" for="FooterNewsletterEmail">Email address</label>
              <input type="email" id="FooterNewsletterEmail" name="contact[email]" required placeholder="you@example.com" value="{% if customer %}{{ customer.email }}{% endif %}">
              <button type="submit" class="btn btn-primary">Subscribe</button>
              {%- if form.posted_successfully? -%}
                <p data-toast-on-load="success:Thanks for joining the Modix insider list."></p>
              {%- endif -%}
            {%- endform -%}
          </div>

      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="container footer-bottom">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}</span>
    <div class="footer-payments">
      {%- for method in section.settings.payment_icons | split: ',' -%}
        <span>{{ method | strip }}</span>
      {%- endfor -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Brand description",
      "default": "Premium electronics engineered for clarity, speed and everyday reliability — designed in-house, tested obsessively."
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "All rights reserved."
    },
    {
      "type": "text",
      "id": "payment_icons",
      "label": "Payment / trust badges (comma separated)",
      "default": "VISA, MC, UPI, PayPal"
    }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text_column",
      "name": "Text / links column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Company" },
        { "type": "richtext", "id": "text", "label": "Content (list items)" }
      ]
    },
    {
      "type": "trust_column",
      "name": "Why Modix (trust list)",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Why Modix" },
        { "type": "text", "id": "trust_1", "label": "Trust line 1", "default": "1-2 year warranty on every product" },
        { "type": "text", "id": "trust_2", "label": "Trust line 2", "default": "Free shipping over ₹2,999" },
        { "type": "text", "id": "trust_3", "label": "Trust line 3", "default": "7-day easy returns" },
        { "type": "text", "id": "trust_4", "label": "Trust line 4", "default": "Secure checkout" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter (native customer form)",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Stay Updated" }
      ]
    }
  ],
  "max_blocks": 6,
  "default": {
    "blocks": [
      { "type": "menu_column", "settings": { "heading": "Shop", "menu": "footer" } },
      {
        "type": "text_column",
        "settings": {
          "heading": "Company",
          "text": "<ul><li><a href=\"/pages/about\">About Modix</a></li><li><a href=\"/pages/contact\">Contact</a></li><li><a href=\"/collections/all\">Shop All</a></li><li><a href=\"/pages/wishlist\">Wishlist</a></li></ul>"
        }
      },
      {
        "type": "text_column",
        "settings": {
          "heading": "Support",
          "text": "<ul><li><a href=\"/pages/contact\">Help Center</a></li><li><a href=\"/pages/contact\">Shipping &amp; Returns</a></li><li><a href=\"/pages/contact\">Warranty</a></li><li><a href=\"/pages/contact\">Track Order</a></li></ul>"
        }
      },
      { "type": "trust_column", "settings": { "heading": "Why Modix" } }
    ]
  }
}
{% endschema %}
