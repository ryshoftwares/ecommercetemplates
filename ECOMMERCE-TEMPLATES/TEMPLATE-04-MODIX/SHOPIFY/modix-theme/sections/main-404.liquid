{%- comment -%}
  sections/main-404.liquid
  Matches the demo's 404.html (.error-page markup) exactly, plus quick
  category links pulled from the header's real menu (same linklist as
  sections/header.liquid) rather than a static hardcoded list.
{%- endcomment -%}
<div class="container error-page">
  <div class="error-page__code">404</div>
  <h1 style="margin-top:16px;">{{ section.settings.heading }}</h1>
  <p style="max-width:52ch;margin:16px auto 0;">{{ section.settings.body }}</p>
  <div class="error-page__actions">
    <a href="{{ routes.root_url }}" class="btn btn-primary btn-lg">{{ section.settings.primary_cta_text }}</a>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn-secondary btn-lg">{{ section.settings.secondary_cta_text }}</a>
  </div>
  {%- liquid
    assign quick_menu = linklists[section.settings.menu]
  -%}
  {%- if quick_menu.links.size > 0 -%}
    <div class="error-page__links">
      {%- for link in quick_menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      <a href="{{ pages.contact.url | default: '/pages/contact' }}">Contact Support</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "404 page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page took an unexpected exit." },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "The page you're looking for doesn't exist, may have been moved, or the link you followed is out of date. Let's get you back to something real — browse our current lineup or head home." },
    { "type": "text", "id": "primary_cta_text", "label": "Primary button label", "default": "Back to Home" },
    { "type": "text", "id": "secondary_cta_text", "label": "Secondary button label", "default": "Shop All Products" },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu to pull quick category links from",
      "default": "main-menu",
      "info": "Uses this menu's top-level links (same menu as the header)."
    }
  ]
}
{% endschema %}
