{%- comment -%}
  sections/spec-comparison.liquid
  Dark charcoal feature-comparison strip, ported 1:1 from the demo's
  .compare-strip / .compare-table markup (index.html "Which Modix Phone is
  right for you?"). Three merchant-picked products fill the column headers
  (with a "model tag" label + real price via snippets/price.liquid); each
  block below is one comparison row so a merchant can add/remove/reorder
  spec rows (Display, Camera, Battery, etc.) without touching code.
{%- endcomment -%}
{%- if section.settings.product_1 != blank -%}
<section class="section compare-strip" data-reveal>
  <div class="container">
    <div class="section-header">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
      {%- if section.settings.view_all_url != blank -%}
        <a href="{{ section.settings.view_all_url }}" class="section-link">{{ section.settings.view_all_text }} {%- render 'icon', icon: 'arrow-right', width: 16, height: 16 -%}</a>
      {%- endif -%}
    </div>
    <div class="compare-strip__table-wrap">
      <table class="compare-table">
        <thead>
          <tr>
            <th></th>
            {%- for i in (1..3) -%}
              {%- assign compare_product = section.settings['product_' | append: i] -%}
              {%- assign model_tag = section.settings['model_tag_' | append: i] -%}
              {%- if compare_product != blank -%}
                <th>{%- if model_tag != blank -%}<span class="model-tag">{{ model_tag }}</span>{%- endif -%}{{ compare_product.title }}</th>
              {%- endif -%}
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th>Price</th>
            {%- for i in (1..3) -%}
              {%- assign compare_product = section.settings['product_' | append: i] -%}
              {%- if compare_product != blank -%}
                <td{% if i == 1 %} class="is-highlight"{% endif %}>{{ compare_product.price | money }}</td>
              {%- endif -%}
            {%- endfor -%}
          </tr>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th>{{ block.settings.label }}</th>
              <td>{{ block.settings.value_1 }}</td>
              <td>{{ block.settings.value_2 }}</td>
              <td>{{ block.settings.value_3 }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Spec comparison strip",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Which Modix Phone is right for you?" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "A quick side-by-side of the specs that actually matter before you buy." },
    { "type": "text", "id": "view_all_text", "label": "\"View all\" link text", "default": "Shop Smartphones" },
    { "type": "url", "id": "view_all_url", "label": "\"View all\" link" },
    { "type": "header", "content": "Products to compare" },
    { "type": "product", "id": "product_1", "label": "Product 1" },
    { "type": "text", "id": "model_tag_1", "label": "Product 1 tag", "default": "Flagship" },
    { "type": "product", "id": "product_2", "label": "Product 2" },
    { "type": "text", "id": "model_tag_2", "label": "Product 2 tag", "default": "Everyday" },
    { "type": "product", "id": "product_3", "label": "Product 3" },
    { "type": "text", "id": "model_tag_3", "label": "Product 3 tag", "default": "Essentials" }
  ],
  "blocks": [
    {
      "type": "spec_row",
      "name": "Spec row",
      "settings": [
        { "type": "text", "id": "label", "label": "Row label", "default": "Display" },
        { "type": "text", "id": "value_1", "label": "Value — product 1" },
        { "type": "text", "id": "value_2", "label": "Value — product 2" },
        { "type": "text", "id": "value_3", "label": "Value — product 3" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Spec comparison strip",
      "settings": {
        "eyebrow": "Compare",
        "heading": "Which Modix Phone is right for you?",
        "subheading": "A quick side-by-side of the specs that actually matter before you buy.",
        "view_all_text": "Shop Smartphones",
        "model_tag_1": "Flagship",
        "model_tag_2": "Everyday",
        "model_tag_3": "Essentials"
      },
      "blocks": [
        { "type": "spec_row", "settings": { "label": "Display", "value_1": "6.7\" 120Hz LTPO", "value_2": "6.4\" 120Hz", "value_3": "6.1\" 90Hz" } },
        { "type": "spec_row", "settings": { "label": "Camera", "value_1": "50MP Triple, 5x Zoom", "value_2": "50MP Dual", "value_3": "48MP Single" } },
        { "type": "spec_row", "settings": { "label": "Battery", "value_1": "5,000mAh / 65W", "value_2": "4,500mAh / 45W", "value_3": "4,000mAh / 25W" } },
        { "type": "spec_row", "settings": { "label": "Water Resistance", "value_1": "IP68", "value_2": "IP67", "value_3": "IP54" } },
        { "type": "spec_row", "settings": { "label": "Wireless Charging", "value_1": "30W", "value_2": "—", "value_3": "—" } }
      ]
    }
  ]
}
{% endschema %}
