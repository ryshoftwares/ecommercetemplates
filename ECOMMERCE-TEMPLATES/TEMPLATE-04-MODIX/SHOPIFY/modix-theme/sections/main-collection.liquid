{%- comment -%}
  sections/main-collection.liquid
  Shop / category page, ported from the demo's shop.html + category.html
  (.shop-layout / .filters-sidebar / .product-grid markup), rebuilt on
  Shopify's real faceted search (collection.filters) instead of the demo's
  client-side js/filters.js array filtering — every facet (price, color,
  availability, and a merchant-configured Compatibility filter driven by the
  product.metafields.custom.compatibility metafield via Search & Discovery)
  comes from collection.filters so it reflects the real catalog and updates
  via a normal filtered-collection page load (progressively enhanced by
  assets/theme.js into an off-canvas drawer on mobile, matching
  .filters-sidebar / .mobile-filter-toggle from the demo).

  AEO INTRO: uses the real collection.description (set per-collection in
  Shopify Admin) as the category intro paragraph — never hardcoded —
  falling back to the section's own text setting only for collections that
  have no description yet.
{%- endcomment -%}
{%- render 'breadcrumb' -%}

<div class="page-header">
  <div class="container">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="page-header__intro">{{ collection.description }}</div>
    {%- elsif section.settings.fallback_intro != blank -%}
      <p class="page-header__intro">{{ section.settings.fallback_intro }}</p>
    {%- endif -%}
  </div>
</div>

<div class="container section">
  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- assign has_active_filters = false -%}
    {%- for filter in collection.filters -%}
      {%- if filter.active_values.size > 0 -%}{%- assign has_active_filters = true -%}{%- endif -%}
    {%- endfor -%}
    {%- if has_active_filters -%}
      <div class="filter-tags">
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <span class="filter-tag">{{ value.label }}
              <a href="{{ value.url_to_remove }}" aria-label="Remove {{ value.label }} filter"><button type="button">{%- render 'icon', icon: 'close', width: 12, height: 12 -%}</button></a>
            </span>
          {%- endfor -%}
        {%- endfor -%}
        <a class="quick-view-btn" href="{{ collection.url }}?sort_by={{ collection.sort_by }}" data-filters-clear-all>{{ 'sections.collection.clear_filters' | t }}</a>
      </div>
    {%- endif -%}

    <div class="shop-layout">
      <div class="overlay-scrim" data-filters-scrim></div>
      <aside class="filters-sidebar" data-filters-sidebar>
        <div class="filters-sidebar__header">
          <h3 style="font-size:16px;">{{ 'sections.collection.filter_title' | t }}</h3>
          <div style="display:flex;gap:12px;align-items:center;">
            <a class="quick-view-btn" href="{{ collection.url }}?sort_by={{ collection.sort_by }}">{{ 'sections.collection.clear_all' | t }}</a>
            <button class="icon-btn filters-drawer-close" type="button" data-filters-drawer-close aria-label="Close filters">{%- render 'icon', icon: 'close', width: 18, height: 18 -%}</button>
          </div>
        </div>

        <form id="CollectionFilterForm" method="get" action="{{ collection.url }}" data-collection-filter-form>
          <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
          {%- for filter in collection.filters -%}
            <div class="filter-group" data-filter-group>
              <div class="filter-group__title" data-filter-group-toggle>
                <span>{{ filter.label }}</span>
                {%- render 'icon', icon: 'chevron', width: 12, height: 12 -%}
              </div>
              <div class="filter-group__body">
                {%- case filter.type -%}

                  {%- when 'price_range' -%}
                    <div class="price-range">
                      <div class="price-range__values">
                        <span>{{ filter.min_value.value | default: filter.range_min | money }}</span>
                        <span>{{ filter.max_value.value | default: filter.range_max | money }}</span>
                      </div>
                      <div class="form-row">
                        <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}" placeholder="Min" aria-label="Minimum price" min="0">
                        <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}" placeholder="Max" aria-label="Maximum price" min="0">
                      </div>
                    </div>

                  {%- when 'boolean' -%}
                    {%- for value in filter.values -%}
                      <label class="checkbox-row">
                        <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}>
                        {{ value.label }} ({{ value.count }})
                      </label>
                    {%- endfor -%}

                  {%- when 'list' -%}
                    {%- if filter.label contains 'Color' or filter.label contains 'Colour' -%}
                      <div class="filter-swatches">
                        {%- for value in filter.values -%}
                          {%- assign swatch_hex = '#8A93A3' -%}
                          {%- case value.label -%}
                            {%- when 'Charcoal' -%}{%- assign swatch_hex = '#17181C' -%}
                            {%- when 'Off-White' -%}{%- assign swatch_hex = '#F5F6F8' -%}
                            {%- when 'Electric Blue' -%}{%- assign swatch_hex = '#2F5DFF' -%}
                            {%- when 'Silver' -%}{%- assign swatch_hex = '#C9CDD6' -%}
                          {%- endcase -%}
                          <a href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
                            class="filter-swatch{% if value.active %} is-active{% endif %}"
                            style="background:{{ swatch_hex }};"
                            title="{{ value.label }} ({{ value.count }})"
                            aria-label="Filter by {{ value.label }}"></a>
                        {%- endfor -%}
                      </div>
                    {%- elsif filter.label contains 'Rating' -%}
                      {%- for value in filter.values -%}
                        <label class="radio-row">
                          <input type="radio" name="{{ filter.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}>
                          {{ value.label }} ({{ value.count }})
                        </label>
                      {%- endfor -%}
                    {%- else -%}
                      {%- for value in filter.values -%}
                        <label class="checkbox-row">
                          <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}>
                          {{ value.label }} ({{ value.count }})
                        </label>
                      {%- endfor -%}
                    {%- endif -%}

                {%- endcase -%}
              </div>
            </div>
          {%- endfor -%}
          <noscript><button type="submit" class="btn btn-primary btn-block" style="margin-top:16px;">{{ 'sections.collection.show_results' | t }}</button></noscript>
        </form>
      </aside>

      <div>
        <div class="grid-toolbar">
          <button class="btn btn-ghost mobile-filter-toggle" type="button" data-mobile-filter-toggle>
            {%- render 'icon', icon: 'filter', width: 16, height: 16 -%} {{ 'sections.collection.filter_title' | t }}
          </button>
          <span class="grid-toolbar__count" data-shop-count>
            {%- if paginate.items == 1 -%}{{ 'sections.collection.result_count.one' | t: count: paginate.items }}{%- else -%}{{ 'sections.collection.result_count.other' | t: count: paginate.items }}{%- endif -%}
          </span>
          <div class="grid-toolbar__right">
            <div class="select-wrap sort-select">
              <select data-shop-sort aria-label="{{ 'sections.collection.sort_by' | t }}" onchange="location.href=this.value">
                {%- for option in collection.sort_options -%}
                  <option value="{{ collection.url }}?sort_by={{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>{{ option.name }}</option>
                {%- endfor -%}
              </select>
            </div>
          </div>
        </div>

        {%- if collection.products.size > 0 -%}
          <div class="product-grid" data-shop-grid style="grid-template-columns:repeat({{ section.settings.columns }},1fr)">
            {%- for product in collection.products -%}
              {%- render 'product-card', product: product -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="empty-state" data-shop-empty>
            {%- render 'icon', icon: 'empty-search', width: 64, height: 64 -%}
            <h3>{{ 'sections.collection.no_products' | t }}</h3>
            <p>{{ 'sections.collection.no_products_body' | t }}</p>
            <a href="{{ collection.url }}" class="btn btn-primary">{{ 'sections.collection.clear_filters' | t }}</a>
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" data-shop-pagination aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous page">‹</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}"><button type="button">{{ part.title }}</button></a>
              {%- else -%}
                <button type="button"{% if part.title == paginate.current_page %} class="is-active"{% endif %}>{{ part.title }}</button>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next page">›</a>{%- endif -%}
          </nav>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection pages",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "textarea",
      "id": "fallback_intro",
      "label": "Fallback intro text",
      "info": "Shown only when a collection has no description set in Shopify Admin.",
      "default": "Every current Modix product in one place. Use the filters to narrow by category, price, color, rating or device compatibility — every listed spec comes straight from our product data sheets."
    }
  ]
}
{% endschema %}
