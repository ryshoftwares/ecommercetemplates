{%- comment -%}
  sections/announcement-bar.liquid
  Rotating announcement bar, ported 1:1 from the demo's .announcement-bar /
  .announcement-bar__track markup. Block-based so merchants can add/remove/
  reorder messages; assets/theme.js cross-fades between them.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="announcement-bar">
  <div class="announcement-bar__track">
    {%- for block in section.blocks -%}
      <div class="announcement-bar__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        <span>
          {%- if block.settings.url != blank -%}<a href="{{ block.settings.url }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
        </span>
      </div>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Message", "default": "Free shipping on orders over ₹2,999" },
        { "type": "url", "id": "url", "label": "Link (optional)" }
      ]
    }
  ],
  "max_blocks": 5,
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "Free shipping on orders over ₹2,999" } },
      { "type": "message", "settings": { "text": "New: the latest Modix smartphone is now shipping" } },
      { "type": "message", "settings": { "text": "Use code MODIX10 for 10% off your first order" } }
    ]
  }
}
{% endschema %}
