{%- comment -%}
  snippets/product-card.liquid
  Ported 1:1 from the demo's js/products.js -> productCardHTML().
  Accepts: product (required), quick_actions (optional bool, default true)

  RATING METAFIELDS (documented convention — no reviews app assumed):
    product.metafields.custom.rating        (number, e.g. 4.6)
    product.metafields.custom.rating_count  (number, e.g. 312)
  If a reviews app (Judge.me / Loox / etc.) is installed, point these two
  lines at that app's namespace instead. When absent, the star row is not
  rendered.

  BADGE LOGIC (computed, never hardcoded):
    - "Sale"         when compare_at_price > price on the card's variant
    - "Best Seller"  when the product has the tag "bestseller"
    - "New"          when the product has the tag "new", or was published
                       within the last 21 days
    - "Editor's Pick" when the product has the tag "editors-pick"
  (Priority mirrors the demo: a status badge OR sale badge — not both, same
  as js/products.js's productCardHTML which only shows one badge slot.)
{%- endcomment -%}
{%- liquid
  assign card_variant = product.selected_or_first_available_variant
  assign on_sale = false
  if card_variant.compare_at_price > card_variant.price
    assign on_sale = true
    assign discount_pct = card_variant.compare_at_price | minus: card_variant.price | times: 100.0 | divided_by: card_variant.compare_at_price | round
  endif

  assign is_bestseller = false
  if product.tags contains 'bestseller'
    assign is_bestseller = true
  endif
  assign is_editors_pick = false
  if product.tags contains 'editors-pick'
    assign is_editors_pick = true
  endif
  assign is_new = false
  if product.tags contains 'new'
    assign is_new = true
  else
    assign created_seconds = product.created_at | date: '%s'
    assign now_seconds = 'now' | date: '%s'
    assign age_days = now_seconds | minus: created_seconds | divided_by: 86400
    if age_days <= 21
      assign is_new = true
    endif
  endif

  assign badge_label = ''
  assign badge_class = ''
  if is_bestseller
    assign badge_label = 'Best Seller'
    assign badge_class = 'badge--accent'
  elsif is_editors_pick
    assign badge_label = "Editor's Pick"
    assign badge_class = ''
  elsif is_new
    assign badge_label = 'New'
    assign badge_class = ''
  endif

  assign show_quick_actions = quick_actions | default: true
  assign secondary_image = product.media[1] | default: product.featured_media

  assign rating = product.metafields.custom.rating.value
  assign rating_count = product.metafields.custom.rating_count.value
-%}
<article class="product-card" data-product-id="{{ product.id }}" data-product-handle="{{ product.handle }}" data-category="{{ product.type | handle }}">
  <div class="product-card__media">
    {%- if badge_label != '' -%}<span class="badge {{ badge_class }}">{{ badge_label }}</span>{%- elsif on_sale -%}<span class="badge badge--sale">-{{ discount_pct }}%</span>{%- endif -%}
    {%- if settings.enable_wishlist -%}
      <button type="button" class="wishlist-toggle" data-wishlist-toggle data-handle="{{ product.handle }}" aria-pressed="false" aria-label="Add {{ product.title | escape }} to wishlist">
        {%- render 'icon', icon: 'wishlist', width: 17, height: 17 -%}
      </button>
    {%- endif -%}
    <a href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
      {%- if product.featured_media -%}
        <img class="img-primary" src="{{ product.featured_media | image_url: width: 600 }}" alt="{{ product.featured_media.alt | default: product.title | escape }}" width="400" height="400" loading="lazy">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'img-primary placeholder-svg' }}
      {%- endif -%}
      {%- if secondary_image -%}
        <img class="img-secondary" src="{{ secondary_image | image_url: width: 600 }}" alt="" width="400" height="400" loading="lazy" aria-hidden="true">
      {%- endif -%}
    </a>
    {%- if show_quick_actions -%}
      <div class="product-card__quick-add">
        <button class="btn btn-dark btn-block btn-sm" type="button" data-quickadd data-variant-id="{{ card_variant.id }}"{% unless card_variant.available %} disabled{% endunless %}>{% if card_variant.available %}{{ 'sections.product.quick_add' | t }}{% else %}{{ 'sections.product.sold_out' | t }}{% endif %}</button>
      </div>
    {%- endif -%}
  </div>
  <div class="product-card__body">
    <span class="product-card__category">{{ product.type | default: product.collections.first.title }}</span>
    <h3 class="product-card__name"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {%- if rating -%}
      <span class="rating">
        <span class="rating__stars" aria-hidden="true">{% for i in (1..5) %}<svg viewBox="0 0 20 20" fill="currentColor" style="opacity:{% if i <= rating %}1{% else %}0.28{% endif %}"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6z"/></svg>{% endfor %}</span>
        <span class="rating__count">{{ rating }} ({{ rating_count | default: 0 }})</span>
      </span>
    {%- endif -%}
    <div class="product-card__actions-row">
      {%- render 'price', product: product, variant: card_variant -%}
      {%- if show_quick_actions -%}
        <button class="quick-view-btn" type="button" data-quickview data-handle="{{ product.handle }}">{{ 'sections.product.quick_view' | t }}</button>
      {%- endif -%}
    </div>
  </div>
</article>
