{%- comment -%}
  snippets/meta-tags.liquid
  Open Graph + Twitter card tags, built from real Liquid objects per
  template. Falls back to shop-level info / theme setting when a page has
  no more specific description or image. Ported from the demo's per-page
  <meta property="og:*"> blocks (index.html, shop.html, product.html, etc).
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_description = page_description | default: settings.default_meta_description | default: shop.description | strip_newlines | truncate: 300
  assign og_type = 'website'
  assign og_image = settings.social_sharing_image

  if template.name == 'product'
    assign og_type = 'product'
    if product.featured_image
      assign og_image = product.featured_image
    endif
    assign og_description = product.description | strip_html | truncate: 300 | default: og_description
  elsif template.name == 'collection'
    if collection.image
      assign og_image = collection.image
    endif
    assign og_description = collection.description | strip_html | truncate: 300 | default: og_description
  elsif template.name == 'page'
    assign og_description = page.content | strip_html | truncate: 300 | default: og_description
  endif
-%}
<meta property="og:site_name" content="Modix">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:type" content="{{ og_type }}">
{%- if og_image %}
<meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
{%- endif %}
{%- if template.name == 'product' -%}
<meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}">
<meta property="product:price:currency" content="{{ cart.currency.iso_code | default: shop.currency }}">
{%- endif %}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if og_image %}
<meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">
{%- endif %}
