{%- comment -%}
  snippets/json-ld-product.liquid
  Product + Offer JSON-LD from real product/variant objects. Currency comes
  from cart.currency (falls back to shop currency), availability from
  variant.available, sku + brand from the variant/product objects.

  RATING: product.metafields.custom.rating / custom.rating_count (numbers).
  When absent, aggregateRating is omitted rather than fabricated — never
  ship a fake rating (see PRODUCTION NOTE in the master demo's js/product.js).

  FAQ JSON-LD is emitted separately by sections/main-product.liquid only
  when custom.faqs is present, so it always matches the visible accordion.
{%- endcomment -%}
{%- liquid
  assign rating = product.metafields.custom.rating.value
  assign rating_count = product.metafields.custom.rating_count.value
  assign currency = cart.currency.iso_code | default: shop.currency
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | json }},
  "image": [{% for media in product.media limit: 6 %}"https:{{ media | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}{% endfor %}],
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | default: shop.name | json }}
  },
  "offers": [
    {%- for v in product.variants -%}
    {
      "@type": "Offer",
      "url": {{ product.url | append: '?variant=' | append: v.id | prepend: shop.url | json }},
      "priceCurrency": {{ currency | json }},
      "price": {{ v.price | divided_by: 100.0 | json }},
      "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
      "sku": {{ v.sku | json }},
      "itemCondition": "https://schema.org/NewCondition"
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]{% if rating %},
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ rating | json }},
    "reviewCount": {{ rating_count | default: 0 | json }}
  }{% endif %}
}
</script>
