{%- comment -%}
  snippets/icon.liquid
  Renders one of MODIX's inline SVG icons, ported 1:1 from the master demo
  markup (index.html header / drawers / cart / wishlist / trust badges /
  category icons). Usage: {% render 'icon', icon: 'search', width: 20, height: 20 %}
{%- endcomment -%}
{%- liquid
  assign w = width | default: 22
  assign h = height | default: 22
-%}
{%- case icon -%}
  {%- when 'menu' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ w }}" height="{{ h }}"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  {%- when 'search' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ w }}" height="{{ h }}"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
  {%- when 'account' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ w }}" height="{{ h }}"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-6 8-6s8 2 8 6"/></svg>
  {%- when 'wishlist' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="{{ w }}" height="{{ h }}"><path d="M12 20.5s-7.5-4.6-10-9.4C.5 7.6 2.4 4 6 4c2.1 0 3.7 1.2 4.7 2.6 1-1.4 2.6-2.6 4.7-2.6 3.6 0 5.5 3.6 4 7.1-2.5 4.8-10 9.4-10 9.4z"/></svg>
  {%- when 'cart' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ w }}" height="{{ h }}"><path d="M3 3h2l2.6 12.6a2 2 0 002 1.4h8.8a2 2 0 002-1.6L21 8H6"/><circle cx="9" cy="21" r="1"/><circle cx="17" cy="21" r="1"/></svg>
  {%- when 'close' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ w }}" height="{{ h }}"><path d="M18 6L6 18M6 6l12 12"/></svg>
  {%- when 'chevron' -%}
    <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" width="{{ w }}" height="{{ h }}" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
  {%- when 'arrow-right' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" width="{{ w }}" height="{{ h }}"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="{{ w }}" height="{{ h }}"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
  {%- when 'twitter' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="{{ w }}" height="{{ h }}"><path d="M4 4l16 16M20 4L4 20"/></svg>
  {%- when 'youtube' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="{{ w }}" height="{{ h }}"><rect x="3" y="6" width="18" height="12" rx="4"/><path d="M11 10l4 2-4 2z" fill="currentColor" stroke="none"/></svg>
  {%- when 'warranty' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ w }}" height="{{ h }}"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/></svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ w }}" height="{{ h }}"><path d="M3 3h2l2.6 12.6a2 2 0 002 1.4h8.8a2 2 0 002-1.6L21 8H6"/><circle cx="9" cy="21" r="1"/><circle cx="17" cy="21" r="1"/></svg>
  {%- when 'returns' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ w }}" height="{{ h }}"><path d="M4 4v6h6M20 20v-6h-6"/><path d="M5 14a8 8 0 0014 3M19 10A8 8 0 005 7"/></svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ w }}" height="{{ h }}"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg>
  {%- when 'check-circle' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ w }}" height="{{ h }}"><path d="M20 6L9 17l-5-5"/></svg>
  {%- when 'check' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ w }}" height="{{ h }}"><path d="M20 6L9 17l-5-5"/></svg>
  {%- when 'alert-circle' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ w }}" height="{{ h }}"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
  {%- when 'info-circle' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ w }}" height="{{ h }}"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
  {%- when 'empty-cart' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="{{ w }}" height="{{ h }}"><path d="M3 3h2l2.6 12.6a2 2 0 002 1.4h8.8a2 2 0 002-1.6L21 8H6"/><circle cx="9" cy="21" r="1"/><circle cx="17" cy="21" r="1"/></svg>
  {%- when 'empty-search' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="{{ w }}" height="{{ h }}"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
  {%- when 'filter' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ w }}" height="{{ h }}"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
  {%- when 'audio' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ w }}" height="{{ h }}"><path d="M4 14v-2a8 8 0 0116 0v2"/><rect x="2" y="14" width="5" height="7" rx="1.5"/><rect x="17" y="14" width="5" height="7" rx="1.5"/></svg>
  {%- when 'phone' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ w }}" height="{{ h }}"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg>
  {%- when 'laptop' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ w }}" height="{{ h }}"><rect x="4" y="4" width="16" height="11" rx="1"/><path d="M2 19h20"/></svg>
  {%- when 'home' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ w }}" height="{{ h }}"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>
  {%- when 'watch' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ w }}" height="{{ h }}"><rect x="7" y="7" width="10" height="10" rx="2"/><path d="M9 7V4h6v3M9 17v3h6v-3"/></svg>
{%- endcase -%}
